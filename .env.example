# Browser-safe public endpoint only (never put the signing secret in VITE_*).
VITE_MULTIPLAYER_URL=ws://localhost:2567

# Set the same strong random value in Convex (`npx convex env set ...`) and the server host.
MULTIPLAYER_TICKET_SECRET=replace-with-at-least-32-random-characters
PORT=2567
CORS_ORIGINS=http://localhost:5173,https://kimchankwon.github.io
